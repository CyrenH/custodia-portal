# Auto-detect text files and normalize line endings to LF by default
* text=auto eol=lf

# Source code — always LF
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.html text eol=lf
*.css text eol=lf
*.md text eol=lf
*.gitignore text eol=lf
*.gitattributes text eol=lf

# Binary files — never touch line endings, never diff as text
*.png binary
*.jpg binary
*.jpeg binary
*.svg binary
*.ico binary